DATABASE_URL=postgresql+psycopg://rag:rag@localhost:5432/rag

# "openai" for real semantic embeddings, "hash" for an offline keyword-ish fallback (no API key needed)
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# vector | keyword | hybrid (keyword + vector merged with Reciprocal Rank Fusion)
SEARCH_MODE=hybrid

LLM_MODEL=gpt-4.1-mini
OPENAI_API_KEY=
